                  "mcp",
                  "entry-instructions",
                  "compatibility-isolation"
                ]
              }
            }
          },
          "required": [
            "skills",
            "agents",
            "mcp",
            "entryInstructions",
            "requires"
          ],
          "additionalProperties": false
        }
      },
